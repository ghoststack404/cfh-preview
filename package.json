{
    "name": "tia-monica",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types",
        "test": "node --test tests/e2e-qa.test.mjs",
        "test:qa": "node scripts/qa-tests/run-all.mjs",
        "test:qa:stress": "node scripts/qa-tests/adversarial-concurrency-stress.mjs",
        "db:generate": "npm run --workspace=apps/web db:generate",
        "db:push": "npm run --workspace=apps/web db:push",
        "db:studio": "npm run --workspace=apps/web db:studio",
        "db:seed": "npm run --workspace=apps/web db:seed",
        "db:seed:categories": "npm run --workspace=apps/web db:seed:categories",
        "setup-tiamonica": "npm install && npx prisma db push --schema=apps/web/prisma/schema.prisma && npm run build",
        "instalar-seguro": "npm install",
        "package:zip": "git archive --format=zip --output=CFH_CodigoFuente_Completo.zip HEAD"
    },
    "devDependencies": {
        "prettier": "^3.7.4",
        "turbo": "^2.10.4",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=24.12.0",
        "npm": ">=11.6.0"
    },
    "packageManager": "npm@11.6.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "marked": "^18.1.0",
        "prisma": "^6.19.3"
    }
}
